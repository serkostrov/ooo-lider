VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Только для локальной разработки без Auth. На стенде показа всегда false.
# VITE_AUTH_BYPASS=false

# --- Уведомления (публичное для фронта) ---
# Username бота без @ (BotFather). Потом просто замените на боевого.
VITE_TELEGRAM_BOT_USERNAME=
# Базовый URL приложения для ссылок в письмах/TG
VITE_APP_URL=http://localhost:8080

# --- Секреты для Edge Functions (supabase secrets / supabase/functions/.env) ---
# Не кладите в VITE_ — иначе утекут в браузер.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
APP_URL=http://localhost:8080
NOTIFY_ENABLED=true
NOTIFY_CRON_SECRET=change-me

# Тестовый SMTP (например Ethereal / Mailtrap) — потом подмените на почту заказчика
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
